{
  "name": "cloudkitchen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "start:dev": "nodemon app.js",
    "be": "npm run start:dev",
    "fe": "npm --prefix cloudkitchen-frontend run start",
    "dev": "concurrently -k -n BE,FE -c yellow,cyan \"npm:be\" \"npm:fe\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.3.1",
    "bootstrap": "^5.3.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mongoose": "^8.18.1",
    "openai": "^6.6.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10"
  }
}
